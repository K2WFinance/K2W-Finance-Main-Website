# K2WFINANCE Server-Side Environment Variables
# Configure in .env.local for local development. Never commit .env.local.
# Configure separately in Vercel Preview and Production environment settings.

# MongoDB Connection URI (Atlas Replica Set required for transactions)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# MongoDB Database Name (e.g. k2wfinance_preview or k2wfinance_production)
MONGODB_DB_NAME=k2wfinance_preview

# Keyed HMAC Secret for IP-Derived Rate Limiting (Server-Only, min 32 characters)
RATE_LIMIT_SECRET=your_server_rate_limit_secret_here

# Optional: Server-configured application URL for origin verification
# APP_URL=http://localhost:3000
